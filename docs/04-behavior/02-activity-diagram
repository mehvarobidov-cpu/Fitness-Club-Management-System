@startuml
title Диаграммаи фаъолият: брон кардани машғулият
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #EAF2F8
  BorderColor #2874A6
  DiamondBackgroundColor #FCF3CF
  DiamondBorderColor #B7950B
}

start
:Мизоҷ ба система ворид мешавад;
:Ҷадвали машғулиятҳоро мекушояд;
:Машғулиятро интихоб мекунад;

if (Машғулият фаъол аст?) then (ҳа)
  :Санҷиши ҷойҳои холӣ;
  if (Ҷойи холӣ мавҷуд аст?) then (ҳа)
    :Санҷиши узвияти мизоҷ;
    if (Узвият фаъол аст?) then (ҳа)
      :Санҷиши бронкунии такрорӣ;
      if (Брони такрорӣ нест?) then (ҳа)
        :Эҷоди брон дар транзаксия;
        :Кам кардани шумораи ҷойҳои дастрас;
        :Нигоҳ доштани брон;
        :Намоиши тасдиқи брон;
      else (не)
        :Намоиши паёми "Шумо аллакай брон доред";
      endif
    else (не)
      :Намоиши паёми "Узвият фаъол нест";
    endif
  else (не)
    :Намоиши паёми "Ҷойҳои холӣ нестанд";
  endif
else (не)
  :Намоиши паёми "Машғулият дастрас нест";
endif

stop
@enduml
